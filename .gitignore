# Rust build output
target/

# Local editor and OS files
.DS_Store

# CortexKit layout: see WORKSPACE.md "Where files go". Internal documents and
# tool state under .cortexkit/ stay out of git. Only release notes, agent skills
# and rules, and WORKER.md (the build and test guidance every worker receives)
# are tracked. scripts/check-cortexkit-layout.sh enforces this in CI.
/.cortexkit/*
!/.cortexkit/release-notes/
!/.cortexkit/skills/
!/.cortexkit/rules/
!/.cortexkit/WORKER.md
