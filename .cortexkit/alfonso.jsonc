{
  // Masons run on Broca, which needs no OpenCode host.
  "substrates": {
    "workloads": {
      "mason": "broca"
    }
  },
  // Masons may run checks, lints and tests on the Linux build server. CI
  // already runs the whole suite on Linux, and no test needs a macOS framework
  // or a fleet binary on disk (the one real-daemon test is #[ignore]d). Keep
  // `cargo build` and the mutation runner on this Mac: a remote build leaves no
  // binary here, so anything that then runs the built binary locally (a
  // release card, a smoke check) would silently run a stale one.
  "remote_exec": {
    "enabled": true
  }
}
