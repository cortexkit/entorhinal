{
  // Masons run on Broca, which needs no OpenCode host.
  "substrates": {
    "workloads": {
      "mason": "broca"
    }
  },
  // Masons' checks, lints and tests run on the Linux build server instead of
  // this Mac. CI already runs the whole suite on Linux, and no test needs a
  // macOS framework or a fleet binary on disk (the one real-daemon test is
  // #[ignore]d). `cargo build` stays local: a remote build leaves no binary on
  // this Mac, so anything that then runs the built binary here (a release
  // card, a smoke check) would silently run a stale one. The mutation runner
  // also stays local.
  "remote_exec": {
    "enabled": true,
    "commands": ["cd", "cargo check", "cargo test", "cargo clippy"]
  }
}
