{
  // Masons run on Broca, which needs no OpenCode host.
  "substrates": {
    "workloads": {
      "mason": "broca"
    }
  },
  // Masons' cargo builds and tests run on the Linux build server instead of
  // this Mac. CI already runs the whole suite on Linux, and no test needs a
  // macOS framework or a fleet binary on disk (the one real-daemon test is
  // #[ignore]d). The mutation runner stays local: it isn't on the server.
  "remote_exec": {
    "enabled": true,
    "commands": ["cd", "cargo build", "cargo check", "cargo test", "cargo clippy"]
  }
}
