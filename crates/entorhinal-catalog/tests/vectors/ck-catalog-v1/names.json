  "binding": [
    {
      "name": "first_publish_binds",
      "note": "id is free: the publish binds it",
      "table": {},
      "publish": "@acme/tools",
      "expect": {
        "ok": true,
        "id": "acme--tools",
        "new_binding": true
      }
    },
    {
      "name": "same_name_again",
      "note": "a later version of the same package reuses its binding",
      "table": {
        "acme--tools": "@acme/tools"
      },
      "publish": "@acme/tools",
      "expect": {
        "ok": true,
        "id": "acme--tools",
        "new_binding": false
      }
    },
    {
      "name": "short_id_bound_to_other_name",
      "note": "PLANTED ROW: no two valid names share a short id, so this table can only arise from a corrupt or migrated row; the check must read the stored table, not recompute",
      "table": {
        "acme--tools": "@acme-legacy/tools"
      },
      "publish": "@acme/tools",
      "expect": {
        "ok": false,
        "code": "id_bound",
        "id": "acme--tools",
        "bound_to": "@acme-legacy/tools"
      }
    },
    {
      "name": "hashed_id_bound_to_other_name",
      "note": "PLANTED ROW standing in for a 64-bit truncated-hash collision, which cannot be computed: the binding refuses the second name",
      "table": {
        "cortexkit--a-very-long-packag_6c425ad00b478de3": "@cortexkit/a-very-long-package-name-that-needs-hashing-x"
      },
      "publish": "@cortexkit/a-very-long-package-name-that-needs-hashing",
      "expect": {
        "ok": false,
        "code": "id_bound",
        "id": "cortexkit--a-very-long-packag_6c425ad00b478de3",
        "bound_to": "@cortexkit/a-very-long-package-name-that-needs-hashing-x"
      }
    },
    {
      "name": "upper_case_publish_refused",
      "note": "the mapping folds case, but a published name must already be canonical",
      "table": {
        "acme--tools": "@acme/tools"
      },
      "publish": "@Acme/Tools",
      "expect": {
        "ok": false,
        "code": "name_not_canonical"
      }
    },
    {
      "name": "invalid_name_refused",
      "note": "grammar refusal comes before the binding check",
      "table": {},
      "publish": "@acme/to_ols",
      "expect": {
        "ok": false,
        "code": "name_invalid"
      }
    }
  ],
